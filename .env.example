# Secrets for the bridge.
#
# You should not have to write this file. `python -m bridge setup` creates it,
# fills it in as it asks, and keeps it at 0600. This copy exists to say what
# ends up in there and why.
#
# .env is in .gitignore. Never commit real values.

# Your own Telegram account. Creating a bot has no Bot API method, so setup
# drives @BotFather through your account; api_id and api_hash come from
# my.telegram.org. The session file this produces is as sensitive as the
# account itself.
TELEMAX_API_ID=1234567
TELEMAX_API_HASH=replace-me
TELEMAX_PHONE=+70000000000

# The guardian bot, created by setup. This is the whole administrative surface:
# MAX login, dialog picking, status and restart all happen in its chat.
TELEMAX_GUARDIAN_TOKEN=555555555:replace-me
TELEMAX_GUARDIAN_TOKEN_USERNAME=telemax_guard_bot

# The MAX account, written by the guardian bot after you connect MAX there.
# The MAX code and the 2FA password are never stored — only the session is.
MAX_PHONE=+70000000000

# One token per bridge. These are written by the guardian when you pick a
# dialog; the names match `telegram_bot_token_env` in the config.
# TELEMAX_BOT_MOM=123456789:replace-me

# Optional overrides, handy for systemd:
# BRIDGE_CONFIG=/etc/max-bridge/config.yaml
# BRIDGE_DATA_DIR=/var/lib/max-bridge
# BRIDGE_LOG_LEVEL=INFO
